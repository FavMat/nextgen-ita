#!/usr/bin/env bash
# Block commit if any staged file contains likely secrets.
# Bypass with: git commit --no-verify  (use only knowingly)
set -e

# Patterns that should NEVER end up in a commit
PATTERNS='(sb_secret_[A-Za-z0-9_-]{10,}|gsk_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|service_role.*eyJ|BEGIN (RSA |EC |OPENSSH |)PRIVATE KEY|AKIA[0-9A-Z]{16}|"type":[[:space:]]*"service_account")'

# Get staged file paths (added or modified), excluding self and lockfiles
files=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -vE '^(\.githooks/|node_modules/)|^(package-lock\.json|yarn\.lock|pnpm-lock\.yaml)$' || true)
[ -z "$files" ] && exit 0

hits=""
while IFS= read -r f; do
  # Skip binaries and ignored files
  [ -f "$f" ] || continue
  if git check-attr -a -- "$f" 2>/dev/null | grep -q "binary: set"; then continue; fi
  if grep -aIqE "$PATTERNS" "$f" 2>/dev/null; then
    hits="$hits\n  - $f"
  fi
done <<< "$files"

if [ -n "$hits" ]; then
  printf "\n\033[1;31m[pre-commit] BLOCKED: likely secret found in:\033[0m"
  printf "$hits\n\n"
  printf "  Run \033[1mgit diff --cached\033[0m and remove the secret, or use \033[1m--no-verify\033[0m if you are 100%% sure.\n\n"
  exit 1
fi
exit 0
