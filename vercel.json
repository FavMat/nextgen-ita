{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/admin.js": {
      "includeFiles": "admin.html"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin.html", "destination": "/api/admin" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/women-health/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    { "source": "/podcast.html",  "destination": "https://nextgenitaly.it/", "permanent": true },
    { "source": "/coaching.html", "destination": "https://nextgenitaly.it/", "permanent": true },
    { "source": "/events.html",   "destination": "https://nextgenitaly.it/", "permanent": true },
    { "source": "/podcast",       "destination": "https://nextgenitaly.it/", "permanent": true },
    { "source": "/coaching",      "destination": "https://nextgenitaly.it/", "permanent": true },
    { "source": "/events",        "destination": "https://nextgenitaly.it/", "permanent": true },
    {
      "source": "/",
      "destination": "/nextgen-ita",
      "permanent": false,
      "has": [{ "type": "host", "value": "nextgenitaly.it" }]
    },
    {
      "source": "/",
      "destination": "/nextgen-ita",
      "permanent": false,
      "has": [{ "type": "host", "value": "www.nextgenitaly.it" }]
    }
  ]
}
