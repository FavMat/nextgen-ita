{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/podcast.html",
      "destination": "https://nextgenitaly.it/",
      "permanent": true
    },
    {
      "source": "/coaching.html",
      "destination": "https://nextgenitaly.it/",
      "permanent": true
    },
    {
      "source": "/events.html",
      "destination": "https://nextgenitaly.it/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/nextgen-ita.html",
      "has": [
        { "type": "host", "value": "(?:www\\.)?nextgenitaly\\.it" }
      ]
    }
  ]
}
